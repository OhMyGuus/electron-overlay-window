{
  "name": "electron-overlay-window",
  "version": "2.0.2",
  "author": {
    "name": "Alexander Drozdov"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/SnosMe/electron-overlay-window.git"
  },
  "license": "MIT",
  "keywords": [
    "window",
    "overlay",
    "electron",
    "event",
    "watch",
    "foreground"
  ],
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "install": "node-gyp rebuild && npm run build-ts",
    "build32": "node-gyp clean configure build --arch=ia32",
    "build64": "node-gyp clean configure build --arch=x64",
    "prebuild": "prebuildify --napi",
    "prebuild:ia32": "prebuildify --napi --arch ia32",
    "build-ts": "tsc",
    "demo:electron": "node-gyp build && npm run build-ts && electron dist/demo/electron-demo.js"
  },
  "files": [
    "dist/index.d.ts",
    "dist/index.js",
    "dist/index.js.map",
    "binding.gyp",
    "src/lib",
    "prebuilds"
  ],
  "devDependencies": {
    "@types/node": "^24.9.0",
    "@types/throttle-debounce": "5.x.x",
    "electron": "^44.0.0",
    "prebuildify": "6.x.x"
  },
  "dependencies": {
    "node-gyp-build": "4.x.x",
    "throttle-debounce": "5.x.x",
    "typescript": "^7.0.2"
  },
  "gypfile": true,
  "engines": {
    "node": ">= 18"
  },
  "peerDependencies": {
    "electron": ">= 10"
  }
}
